# AI Job Intelligence - Local development
# Copy to .env in repo root and in infra/ for docker-compose

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobs
# For worker (sync) use same URL with postgresql:// (no +asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobs

# Redis
REDIS_URL=redis://localhost:6379/0

# Candidate profile used for scoring (copy profile.example.yaml to profile.yaml)
PROFILE_PATH=profile.yaml

# AI features (optional - rules are used when no key/base URL is set). See README "AI features and budget".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=gpt-4.1-mini
LLM_MONTHLY_BUDGET_USD=0.80
LLM_MAX_EXTRACTIONS_PER_DAY=30
LLM_MAX_COVER_LETTERS_PER_DAY=5
# Any OpenAI-compatible server, e.g. local Ollama: http://localhost:11434/v1 (not billed)
LLM_BASE_URL=

# Notion sync (optional): integration token + database shared with the integration
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Salary scoring currency rates (optional): USD per unit, merged over the dated table in worker/salary.py
# FX_RATES_JSON={"EUR": 1.17, "KES": 0.0077}
FX_RATES_JSON=

# Full descriptions for sources that return excerpts: fetch the posting page when the description is
# shorter than MIN_CHARS (0 = off), at most MAX_PAGES pages / MAX_SECONDS per scrape run
FULL_DESCRIPTION_SOURCES=remoteok,himalayas
FULL_DESCRIPTION_MIN_CHARS=1500
FULL_DESCRIPTION_MAX_PAGES=10
FULL_DESCRIPTION_MAX_SECONDS=20

# Webhook alert (optional) for jobs at or above notify_threshold in the profile
ALERT_WEBHOOK_URL=

# App
DEBUG=false
