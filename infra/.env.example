# AI Job Intelligence - Local development
# Copy to .env in repo root and in infra/ for docker-compose

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobs
# For worker (sync) use same URL with postgresql:// (no +asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobs

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (optional - worker uses heuristics if missing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alerts (optional)
ALERT_WEBHOOK_URL=
ALERT_SCORE_THRESHOLD=0.7

# App
DEBUG=false
